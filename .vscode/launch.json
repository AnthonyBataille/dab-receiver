{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DAB receiver (summary)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\Debug\\dab_receiver.exe",
      "args": ["${input:iqFile}", "${input:sampleRate}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    },
    {
      "name": "Debug DAB receiver (diagnostics)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\Debug\\dab_receiver.exe",
      "args": ["${input:iqFile}", "${input:sampleRate}", "--power-csv", "${input:powerCsv}", "--spectrum-csv", "${input:spectrumCsv}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    },
    {
      "name": "Debug IQ reader test",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\Debug\\dab_iq_reader_test.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    },
    {
      "name": "Debug IQ summary test",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\Debug\\dab_iq_summary_test.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "iqFile",
      "type": "promptString",
      "description": "IQ recording path",
      "default": ".\\dab_11d_10s_u8.iq"
    },
    {
      "id": "sampleRate",
      "type": "promptString",
      "description": "Complex samples per second",
      "default": "2048000"
    },
    {
      "id": "powerCsv",
      "type": "promptString",
      "description": "Path to power CSV",
      "default": ".\\out\\power.csv"
    },
    {
      "id": "spectrumCsv",
      "type": "promptString",
      "description": "Path to spectrum CSV",
      "default": ".\\out\\spectrum.csv"
    }
  ]
}
